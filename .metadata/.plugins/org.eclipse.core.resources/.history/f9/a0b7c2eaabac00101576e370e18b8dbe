package com.jpmc.midascore;

import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;

@Component
public class TransactionListener {

    private final List<Double> firstFourAmounts = new ArrayList<>();

    @KafkaListener(topics = "${general.kafka-topic}", groupId = "midas-core-group")
    public void receive(Transaction transaction) {
        // Collect amounts of the first four transactions
        if (firstFourAmounts.size() < 4) {
            firstFourAmounts.add(transaction.getAmount());
            System.out.println("Received transaction #" + firstFourAmounts.size() + ": " + transaction.getAmount());
        }

        // Once four transactions are collected, print all together
        if (firstFourAmounts.size() == 4) {
            System.out.println("First four transaction amounts: " + firstFourAmounts);
        }
    }

    // Optional: getter if you want to use it elsewhere
    public List<Double> getFirstFourAmounts() {
        return new ArrayList<>(firstFourAmounts);
    }
}
